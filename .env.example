# Local development configuration.
#
# [MANDATORY] CODING_GUIDELINES §12: no real secrets in this repo, ever. This
# file documents the shape only; copy to .env (git-ignored) and fill in locally.
# In production, school-DB credentials come from AWS Secrets Manager and BYOK
# keys from the key vault -- never from environment variables.

# ── Platform DB (MySQL 8 -- PROJECT_CONTEXT.md §7) ──────────────────────────
PLATFORM_DB_HOST=127.0.0.1
PLATFORM_DB_PORT=3306
PLATFORM_DB_NAME=analytics_platform
PLATFORM_DB_USER=analytics_app
PLATFORM_DB_PASSWORD=

# ── School data plane ───────────────────────────────────────────────────────
# Resolves the registry's `env://SCHOOL_DB_CREDENTIALS` secret reference. In
# production this ARN points at Secrets Manager; the resolution interface is the
# same either way (ADR-013 keeps credential acquisition in one function).
SCHOOL_DB_USER=analytics_ro
SCHOOL_DB_PASSWORD=

# ── Stub ERP (development only) ─────────────────────────────────────────────
# The RS256 keypair the stub signs launch tokens with. Generated locally by
# `npm run erp:keygen`; the real ERP publishes its own JWKS (docs/02 §2).
ERP_JWKS_URL=http://localhost:4000/.well-known/jwks.json
ERP_ISSUER=http://localhost:4000

# ── Orchestrator ────────────────────────────────────────────────────────────
ORCHESTRATOR_PORT=3000
SESSION_SECRET=
# Must match the port in apps/web/vite.config.ts: the orchestrator CORS
# allowlist names exactly one origin, so a mismatch fails visibly.
SPA_ORIGIN=http://localhost:5174

# ── MCP server (private network only -- docs/04 §6) ─────────────────────────
MCP_PORT=3100
MCP_BIND_HOST=127.0.0.1
MCP_URL=http://127.0.0.1:3100/mcp

# ── MCP call context ────────────────────────────────────────────────────────
# Shared between the orchestrator (which signs one short-lived context per MCP
# call) and the MCP server (which verifies it before any tool exists to be
# called). Deliberately NOT the same value as SESSION_SECRET: the session cookie
# and the MCP call context are different artifacts with different lifetimes and
# audiences, and one compromised secret should not be two.
MCP_CONTEXT_SECRET=
