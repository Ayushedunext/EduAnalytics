# Staging configuration. Copy to deploy/staging/.env and fill in.
#
#     cp deploy/staging/.env.staging.example deploy/staging/.env
#     ./deploy/staging/scripts/make-secrets.sh      # fills every CHANGE_ME below
#
# docker compose loads deploy/staging/.env automatically, because it sits beside
# docker-compose.yml. It is git-ignored and chmod 600, and it must stay that
# way: [MANDATORY] CODING_GUIDELINES §12 forbids real secrets in this
# repository, and by the time this file is filled in it holds every credential
# to the environment.
#
# This is NOT the repository-root .env. That one configures local development
# against a MySQL on the developer's own machine; this one configures the
# containers. Keeping them separate is what stops a local experiment from
# pointing at staging, and a staging redeploy from picking up a laptop's
# leftover settings.

# ── Where this deployment lives ──────────────────────────────────────────────
#
# The DNS name must already resolve to this host before the first `up`: Caddy
# requests a Let's Encrypt certificate for it on boot, and the challenge fails
# if the name does not point here yet. Failed challenges count against the rate
# limit, so pointing DNS first is not just tidiness.
#
# No scheme, no path, no port. Just the hostname.
STAGING_HOSTNAME=CHANGE_ME.example.com

# Where certificate-expiry warnings go. A real mailbox someone reads.
ACME_EMAIL=CHANGE_ME@example.com

# ── Who may reach the environment ────────────────────────────────────────────
#
# Space-separated CIDRs. Empty/unset means anyone on the internet may reach the
# sign-in page -- which is a real decision, not a default to leave unexamined,
# because this box holds a copy of real school data. The application's own
# password gate is in front of everything, but narrowing the network is the
# cheapest additional protection there is.
#
#   STAGING_ALLOW_CIDRS="203.0.113.0/24 198.51.100.7/32"
#
# Changing it takes effect with: docker compose up -d proxy
STAGING_ALLOW_CIDRS=

# ── Demo sign-in accounts ────────────────────────────────────────────────────
#
# One password per role. `make-secrets.sh` generates all six. An account left
# EMPTY does not exist -- it cannot be signed in as and is not listed on the
# page (tools/erp-stub/src/logins.ts) -- so deleting a line is how you disable
# a role rather than something that quietly opens it.
#
# The username is the identity key, i.e. the name in the variable, lowercased
# with underscores as hyphens: ERP_STUB_PASSWORD_PRINCIPAL_MB -> `principal-mb`.
#
# What each one can see is defined in tools/erp-stub/src/identities.ts and is
# worth choosing deliberately for a demo:
#
#   director            all 3 St Marks schools; can combine and compare them
#   principal-mb        Meera Bagh only -- shows scope isolation against...
#   principal-j         ...Janakpuri only
#   principal-training  the only account with attendance data
#   accountant-mb       fees only, no students.read; a different cache class
#   admin               the only role that can configure the org's AI key
ERP_STUB_PASSWORD_DIRECTOR=CHANGE_ME
ERP_STUB_PASSWORD_PRINCIPAL_MB=CHANGE_ME
ERP_STUB_PASSWORD_PRINCIPAL_J=CHANGE_ME
ERP_STUB_PASSWORD_PRINCIPAL_TRAINING=CHANGE_ME
ERP_STUB_PASSWORD_ACCOUNTANT_MB=CHANGE_ME
ERP_STUB_PASSWORD_ADMIN=CHANGE_ME

# Lists the valid usernames on the sign-in page. Handy when sharing a link with
# reviewers, and a published list of accounts to guess passwords against. Off by
# default; turn it on only behind STAGING_ALLOW_CIDRS.
ERP_STUB_SHOW_ACCOUNTS=false

# ── Database ─────────────────────────────────────────────────────────────────
#
# Generated by make-secrets.sh. The two users exist with deliberately different
# rights: the platform user reads and writes the platform's own database, and
# the school user holds SELECT and nothing else over the school extract
# (Invariant 3). See mysql-init/01-databases-and-users.sh.
MYSQL_ROOT_PASSWORD=CHANGE_ME

PLATFORM_DB_NAME=analytics_platform
PLATFORM_DB_USER=analytics_app
PLATFORM_DB_PASSWORD=CHANGE_ME

SCHOOL_DB_NAME=ai_analysis
SCHOOL_DB_USER=analytics_ro
SCHOOL_DB_PASSWORD=CHANGE_ME

# InnoDB buffer pool. The extract is ~1 GB and the fee tables are what every
# dashboard scans, so this is the setting that decides whether staging feels
# like the product. Give it what the host can spare -- on a 4 GB box, 2G.
MYSQL_BUFFER_POOL=1G

# ── Application secrets ──────────────────────────────────────────────────────
#
# Three distinct values, generated separately, for three distinct audiences.
# The repository-root .env.example explains why at length; the short version is
# that rotating one must not force rotating the others.
#
#   SESSION_SECRET        signs our own 8-hour session cookie (ADR-004)
#   MCP_CONTEXT_SECRET    signs the call context between orchestrator and MCP
#   AI_KEY_ENCRYPTION_KEY encrypts the org's own Anthropic key (ADR-017);
#                         base64 of exactly 32 bytes, not an arbitrary string
SESSION_SECRET=CHANGE_ME
SESSION_TTL_HOURS=8
MCP_CONTEXT_SECRET=CHANGE_ME
AI_KEY_ENCRYPTION_KEY=CHANGE_ME

# The issuer string the launch tokens carry. The orchestrator verifies it
# exactly, so this must be identical on both services -- compose passes the one
# value to both. There is no reason to change it: it is an identifier, not an
# address, and nothing fetches it.
ERP_ISSUER=http://idp:4000

# ── Tunables ─────────────────────────────────────────────────────────────────
#
# Documented defaults from docs/03, docs/06 and docs/09. Present so they can be
# changed without editing the compose file.
CACHE_ENABLED=true
CACHE_TTL_SECONDS=600
REDIS_MAXMEMORY=512mb
ROW_CAP=5000
QUERY_TIMEOUT_MS=10000
PDF_TIMEOUT_MS=30000

# ── Not here on purpose: the Anthropic API key ───────────────────────────────
#
# Ask AI runs on the ORGANISATION's own key, entered through the UI by the admin
# account and stored encrypted in the platform database (BYOK, ADR-017,
# Invariant 5). It is not environment configuration, and putting one here would
# not switch the feature on -- every /api/ai/* endpoint reads the org's gating
# state from the vault, server-side, on every request.
#
# To enable Ask AI on staging: sign in as `admin`, open Settings, and paste the
# key there. Until then the AI screens render their locked state, which is
# itself worth demonstrating.
