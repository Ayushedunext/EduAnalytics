{
  "name": "school-analytics-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "AI-powered analytics and automation module embedded in the school ERP. See CLAUDE.md and docs/.",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build --force && tsc -p apps/orchestrator && tsc -p apps/mcp-server && tsc -p apps/web",
    "db:migrate": "node db/scripts/migrate.mjs",
    "db:reset": "node db/scripts/migrate.mjs --seed",
    "erp:dev": "npm run dev -w @sap/erp-stub",
    "api:dev": "npm run dev -w @sap/orchestrator",
    "mcp:dev": "npm run dev -w @sap/mcp-server",
    "mcp:probe": "npm run probe -w @sap/mcp-server",
    "web:dev": "npm run dev -w @sap/web"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "dotenv": "^17.4.2",
    "mysql2": "^3.23.3",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.23.5"
  },
  "overrides": {
    "zod": "$zod"
  }
}
